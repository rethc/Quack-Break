{
  "expo": {
    "name": "Quack Break",
    "slug": "quack-break",
    "scheme": "quackbreak",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "bundleIdentifier": "com.chesd.quackbreak",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.chesd.quackbreak",
      "adaptiveIcon": {
        "backgroundColor": "#A8DCEF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#F5B935",
          "sounds": [
            "./assets/sounds/quack.wav",
            "./assets/sounds/chime.wav",
            "./assets/sounds/drop.wav",
            "./assets/sounds/bell.wav",
            "./assets/sounds/beep.wav",
            "./assets/sounds/voice_heart_rest.wav",
            "./assets/sounds/voice_heart_work.wav",
            "./assets/sounds/voice_bella_rest.wav",
            "./assets/sounds/voice_bella_work.wav",
            "./assets/sounds/voice_michael_rest.wav",
            "./assets/sounds/voice_michael_work.wav",
            "./assets/sounds/voice_george_rest.wav",
            "./assets/sounds/voice_george_work.wav"
          ]
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Fredoka-Regular.ttf",
            "./assets/fonts/Fredoka-SemiBold.ttf",
            "./assets/fonts/Fredoka-Bold.ttf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#FFF8E7",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#121A2C"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "expo-status-bar"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "9aa40dd2-47ed-4e10-a241-6786febbff10"
      }
    },
    "owner": "rethc"
  }
}
